{
  "name": "@comchatx/cx-topics",
  "version": "0.1.6",
  "description": "Titles each piece of work, and reads quotes in context.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-topics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-topics.git"
  },
  "bugs": "https://github.com/comchatx/cx-topics/issues",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions"
    ]
  },
  "files": [
    "dist",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "about": "每件事都有标题，引用旧消息时 cx 连前后一起读。",
    "mark": {
      "line": "hash"
    },
    "section": "extensions",
    "order": 100,
    "builds": [
      "jev"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "esbuild": "0.27.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
